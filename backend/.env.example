# 复制为 .env 后填写实际值；.env 不得提交、不得外发
APP_ENV=development

# JWT 签名密钥（生产必须使用随机长字符串）
JWT_SECRET=please-change-me-to-a-random-long-string

# DeepSeek API 配置（Anthropic 兼容端点，路径不要漏掉 /anthropic）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash
# 关闭思考链：结构化输出无需推理，可显著降低耗时
DEEPSEEK_DISABLE_THINKING=true

# 可选：自定义数据库路径（默认 backend/travel.db）
# SQLITE_PATH=

# ---------- 安全加固（默认值即可，按需覆盖） ----------
# 接口文档开关：不设置时开发环境开启、生产环境关闭；生产切勿开启
# ENABLE_DOCS=false

# 请求体上限（字节，默认 1MB）
# MAX_BODY_BYTES=1048576
# 单份计划内容上限（字节，默认 512KB）
# MAX_PLAN_CONTENT_BYTES=524288

# 接口限流（单 worker 内存实现；每分钟每 IP 次数）
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=20
# RATE_LIMIT_REGISTER=10
# RATE_LIMIT_CHECK=60
# RATE_LIMIT_GENERATE=5
# RATE_LIMIT_SAVE=20

# 生成接口全局并发上限（同时进行中的生成请求数，默认 4）
# GENERATE_CONCURRENCY=4
